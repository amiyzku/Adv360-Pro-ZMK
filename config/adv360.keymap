#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1     &kp N2    &kp N3  &kp N4  &kp N5  &to 4                                                                    &to 4      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0     &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E   &kp R   &kp T   &kp HOME                                                                 &kp PLUS   &kp Y   &kp U   &kp I      &kp O     &kp P      &kp BSLH
&kp CLCK   &kp A      &kp S     &kp D   &kp F   &kp G   &kp END    &kp C_PLAY_PAUSE  &kp C_MUTE             &kp LEFT  &kp RIGHT  &kp MINUS  &kp H   &kp J   &kp K      &kp L     &kp SEMI   &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C   &kp V   &kp B                                &kp C_VOLUME_UP        &kp UP                          &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH   &kp EQUAL
&kp LGUI   &kp LCTRL  &kp LALT  &mo 3   &mo 2           &kp SPACE  &kp BSPC          &kp C_VOLUME_DOWN      &kp DOWN  &mo 1      &kp ENTER          &mo 2   &kp LBKT   &kp RBKT  &kp GRAVE  &none
            >;
        };

        combo {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH       &kp DOLLAR  &kp PERCENT  &none                                           &none   &kp CARET  &kp AMPERSAND   &kp ASTERISK          &trans                 &trans        &trans
&trans  &kp HOME         &kp PAGE_UP  &kp PAGE_DOWN  &kp END     &kp PERCENT  &trans                                          &trans  &kp GRAVE  &kp UNDERSCORE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE      &kp PIPE
&trans  &kp LEFT         &kp UP       &kp DOWN       &kp RIGHT   &trans       &trans  &trans      &trans      &trans  &trans  &trans  &kp TILDE  &kp EQUAL       &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp COLON     &kp DOUBLE_QUOTES
&trans  &trans           &trans       &trans         &trans      &trans                           &trans      &trans                  &kp PLUS   &kp MINUS       &kp LESS_THAN         &kp GREATER_THAN       &kp QUESTION  &trans
&trans  &trans           &trans       &none          &none                    &trans  &kp DELETE  &trans      &trans  &trans  &trans             &none           &trans                &trans                 &trans        &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5  &none                                       &none   &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans   &trans   &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans   &trans
            >;
        };

        num {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &kp N7  &kp N8  &kp N9   &kp ASTERISK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6   &kp MINUS     &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &kt N1  &kp N2  &kp N3   &kp PLUS      &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &kp N0  &kp DOT  &kp EQUAL     &trans
            >;
        };

        config {
            display-name = "Mod";
            bindings = <
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &to 0                                  &to 0  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &bt BT_CLR    &bt BT_CLR    &bt BT_CLR    &bt BT_CLR    &bt BT_CLR    &none                                  &none  &bt BT_CLR    &bt BT_CLR    &bt BT_CLR    &bt BT_CLR    &bt BT_CLR    &none
&none        &none         &none         &none         &none         &none         &none  &none  &none      &none  &none  &none  &none         &none         &none         &none         &none         &none
&none        &none         &none         &none         &none         &none                       &none      &none                &none         &none         &none         &none         &none         &none
&bootloader  &none         &none         &none         &none                       &none  &none  &none      &none  &none  &none                &none         &none         &none         &none         &bootloader
            >;
        };
    };
};
